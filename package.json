{
    "name": "netlogs",
    "version": "2.16.0",
    "description": "Web extension for custom network logs representation",
    "main": "index.js",
    "author": "artboomy",
    "repository": "https://github.com/Artboomy/netlogs",
    "license": "LGPL-3.0-only",
    "private": true,
    "type": "module",
    "scripts": {
        "lint": "node scripts/lint-translations.cjs && yarn run npm-run-all --parallel lint:tsc lint:eslint",
        "lint:tsc": "tsc --noEmit --incremental --tsBuildInfoFile ./.cache/.tsbuildinfo-noEmit",
        "lint:eslint": "eslint -c eslint.config.js --cache --cache-location ./.cache/.eslintcache --max-warnings=0 ./src",
        "mockSecrets": "node scripts/mock-secrets.cjs",
        "strip:dev-version": "node scripts/strip-manifest-timestamp.cjs",
        "lint:ci": "yarn run mockSecrets && yarn run lint",
        "build": "cross-env NODE_ENV=development vite build --config vite.config.extension.ts --mode development",
        "build:prod": "yarn run lint && vite build --config vite.config.extension.ts --mode production",
        "dev:standalone": "cross-env NODE_ENV=development vite build --config vite.config.standalone.ts --mode development",
        "build:standalone": "yarn run vite build --config vite.config.standalone.ts --mode production",
        "preview:standalone": "yarn run build:standalone && node scripts/preview-standalone.cjs",
        "build:analyze:treemap": "cross-env ANALYZE=treemap vite build --config vite.config.extension.ts --mode development",
        "build:analyze:sunburst": "cross-env ANALYZE=sunburst vite build --config vite.config.extension.ts --mode development",
        "build:analyze:network": "cross-env ANALYZE=network vite build --config vite.config.extension.ts --mode development",
        "build:watch": "vite build --config vite.config.extension.ts --watch",
        "package": "yarn run build:prod && cd dist && tar -caf ../netlogs.zip * && cd ..",
        "package:macos": "yarn run build:prod && cd dist && zip -qr ../netlogs.zip . && cd ..",
        "package:dev": "yarn run build && cd dist && tar -caf ../netlogs.zip * && cd ..",
        "package:dev:macos": "yarn run build && cd dist && zip -qr ../netlogs.zip . && cd ..",
        "cleanup": "if exist test_build rmdir /s /q test_build",
        "cleanup:macos": "rm -rf test_build",
        "extract": "mkdir test_build && powershell -command \"Expand-Archive -Path netlogs.zip -DestinationPath test_build\"",
        "extract:macos": "mkdir -p test_build && ditto -x -k netlogs.zip test_build",
        "package:test:dev": "yarn run cleanup && yarn run package:dev && yarn run extract",
        "package:test:dev:macos": "yarn run cleanup:macos && yarn run package:dev:macos && yarn run extract:macos",
        "package:test:prod": "yarn run cleanup && yarn run package && yarn run extract",
        "package:test:prod:macos": "yarn run cleanup:macos && yarn run package:macos && yarn run extract:macos",
        "site": "vite serve dist",
        "storybook": "yarn ladle serve",
        "build-storybook": "yarn ladle build",
        "bump": "node update-version.cjs",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "test:e2e": "yarn build:e2e && playwright test",
        "test:e2e:ui": "yarn build:e2e && playwright test --ui",
        "test:e2e:headed": "yarn build:e2e && playwright test --headed",
        "test:e2e:report": "playwright show-report",
        "test:e2e:coverage": "yarn build:e2e:coverage && playwright test && yarn test:e2e:coverage:report",
        "test:e2e:coverage:report": "nyc report --temp-dir coverage-e2e/.nyc_output --report-dir coverage-e2e --reporter=html --reporter=text-summary",
        "test:e2e:coverage:open": "start coverage-e2e/index.html",
        "build:e2e": "cross-env NODE_ENV=test vite build --config vite.config.standalone.ts --mode development",
        "build:e2e:coverage": "cross-env NODE_ENV=test E2E_COVERAGE=true vite build --config vite.config.standalone.ts --mode development",
        "prepare": "husky"
    },
    "dependencies": {
        "@emotion/css": "^11.13.5",
        "@emotion/react": "^11.11.4",
        "@emotion/styled": "^11.11.5",
        "base16": "1.0.0",
        "classnames": "2.2.6",
        "copy-to-clipboard": "^3.3.3",
        "dompurify": "^3.4.13",
        "i18n-js": "^4.5.3",
        "jszip": "^3.10.1",
        "lodash.clonedeep": "4.5.0",
        "lodash.isequal": "4.5.0",
        "nanoid": "5.0.9",
        "rc-tooltip": "^6.4.0",
        "react": "^18.2.0",
        "react-arborist": "3.4.3",
        "react-dnd": "^16.0.1",
        "react-dnd-html5-backend": "^16.0.1",
        "react-dom": "^18.2.0",
        "react-inspector": "https://github.com/Artboomy/react-inspector/releases/download/v5.4.1/react-inspector-5.4.1.tgz",
        "react-multi-select-component": "^4.3.4",
        "react-toastify": "^10.0.5",
        "react-use": "17.6.1",
        "zustand": "^4.5.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@istanbuljs/nyc-config-typescript": "^1.0.2",
        "@ladle/react": "^5.1.1",
        "@playwright/test": "^1.57.0",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "16.3.2",
        "@types/base16": "1.0.2",
        "@types/chrome": "0.0.262",
        "@types/classnames": "2.2.11",
        "@types/har-format": "1.2.5",
        "@types/lodash.clonedeep": "4.5.6",
        "@types/lodash.isequal": "4.5.5",
        "@types/node": "^20.12.5",
        "@types/react": "^18.2.74",
        "@types/react-dom": "^18.2.24",
        "@vitejs/plugin-react": "6.0.5",
        "@vitest/coverage-v8": "4.1.10",
        "@vitest/ui": "4.1.10",
        "cross-env": "^7.0.3",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.4",
        "eslint-plugin-react": "^7.37.5",
        "happy-dom": "20.11.1",
        "husky": "^9.1.7",
        "npm-run-all": "^4.1.5",
        "nyc": "^18.0.0",
        "prettier": "^3.2.5",
        "rollup-plugin-visualizer": "^7.0.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0",
        "typescript-language-server": "^5.3.0",
        "vite": "8.2.0",
        "vite-plugin-circular-dependency": "^0.6.0",
        "vite-plugin-istanbul": "9.0.1",
        "vitest": "4.1.10"
    },
    "resolutions": {
        "**/js-yaml": "3.15.0",
        "**/postcss": "8.5.25",
        "**/shell-quote": "1.10.0",
        "@ladle/react/vite": "6.4.3",
        "eslint/**/brace-expansion": "5.0.9",
        "nyc/**/brace-expansion": "5.0.9",
        "typescript-eslint/**/brace-expansion": "5.0.9",
        "eslint-plugin-react/**/brace-expansion": "1.1.18",
        "npm-run-all/**/brace-expansion": "1.1.18",
        "vitest/vite": "8.2.0"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
    "nyc": {
        "extends": "@istanbuljs/nyc-config-typescript",
        "all": true,
        "include": [
            "src/**/*.ts",
            "src/**/*.tsx"
        ],
        "exclude": [
            "src/**/*.test.ts",
            "src/**/*.spec.ts",
            "src/**/*.d.ts"
        ],
        "sourceMap": true
    }
}
